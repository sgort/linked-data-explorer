              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Document set {{contractdocumentenReferentie}} for project {{projectNumber}} — {{projectName}} was collected on {{contractdocumentenVerzameldOp}}."

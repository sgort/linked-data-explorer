      "label": "Available project credit"
    },
    {
      "id": "b7",
      "placeholder": "{{memoBestekOnderbouwing}}",
      "variableKey": "memoBestekOnderbouwing",
      "source": "process",
      "label": "Substantiation"
    }
  ],
  "zones": {

    {
      "id": "b7",
      "placeholder": "{{notaAoEindafrekeningToelichting}}",
      "variableKey": "notaAoEindafrekeningToelichting",
      "source": "process",
      "label": "Substantiation"
    },
    {
      "id": "b8",
      "placeholder": "{{notaAoEindafrekeningOp}}",
      "variableKey": "notaAoEindafrekeningOp",
      "source": "process",
      "label": "Drawn up on"
    }
  ],
  "zones": {

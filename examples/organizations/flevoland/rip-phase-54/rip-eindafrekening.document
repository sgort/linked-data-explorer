                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "It falls {{kredietAanneemsom}} and lies {{eindafrekeningWaarde}} the EUR 50.000 threshold, which decides the decision route the letter takes."
                  }
                ]
              }
            ]
          }
        }
      ]

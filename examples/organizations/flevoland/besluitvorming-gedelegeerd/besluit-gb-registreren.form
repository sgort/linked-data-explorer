      "disabled": true
    },
    {
      "id": "Field_Tf_74",
      "type": "textfield",
      "label": "Zaaknummer (zaaksysteem)",
      "key": "zaaknummer",
      "validate": {
        "required": true
      }
    },
    {
      "id": "Field_Tf_75",

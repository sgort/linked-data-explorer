    "body": {
      "blocks": [
        {
          "id": "ob1",
          "type": "text",
          "label": "Object tree",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": { "level": 2 },
                "content": [{ "type": "text", "text": "Object tree" }]
              },
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "The object decomposition for project {{projectNumber}} — {{projectName}} is maintained in Relatics at reference {{objectenboomReferentie}}. This document records the subsystem-level snapshot of that decomposition as agreed for the VO." }
                ]
              }
            ]
          }
        }
      ]

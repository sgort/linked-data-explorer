    { "id": "b3", "placeholder": "{{projectType}}", "variableKey": "projectType", "source": "process", "label": "Project type" },
    { "id": "b4", "placeholder": "{{objectenboomReferentie}}", "variableKey": "objectenboomReferentie", "source": "process", "label": "Object tree reference" }
  ],
  "zones": {

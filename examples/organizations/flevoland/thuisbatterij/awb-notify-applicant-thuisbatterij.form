{
  "components": [
    {
      "text": "# Phase 6 – Notify applicant of thuisbatterij subsidy decision (Awb 3:6)\nUse this form after the substantive review. It shows the final thuisbatterij subsidy decision and the calculated/reviewed amount that will be communicated to the applicant.",
      "id": "Text_Header",
      "type": "text"
    },
    {
      "text": "## Application summary",
      "id": "Text_AppDetails",
      "type": "text"
    },
    {
      "subtype": "date",
      "id": "Field_AanvraagDatum",
      "key": "aanvraagDatum",
      "type": "datetime",
      "label": "Application date",
      "disabled": true,
      "readonly": true,
      "dateLabel": "Application date",
      "description": "Date entered in the review form."
    },
    {
      "label": "Province of the home",
      "id": "Field_ProvincieWoning",
      "key": "provincieWoning",
      "type": "textfield",
      "disabled": true,
      "readonly": true
    },
    {
      "label": "Relation to the home",
      "id": "Field_RelatieTotWoning",
      "key": "relatieTotWoning",
      "type": "textfield",
      "disabled": true,
      "readonly": true
    },
    {
      "label": "Applicant type",
      "id": "Field_AanvragerType",
      "key": "aanvragerType",
      "type": "textfield",
      "disabled": true,
      "readonly": true
    },
    {
      "label": "Costs incurred",
      "id": "Field_GemaakteKosten",
      "key": "gemaakteKosten",
      "type": "number",
      "disabled": true,
      "readonly": true,
      "description": "Amount in euros from the review form.",
      "decimalDigits": 2
    },
    {
      "text": "## Review and decision outcome",
      "id": "Text_Decision",
      "type": "text"
    },
    {
      "label": "Status",
      "id": "Field_Status",
      "key": "status",
      "type": "textfield",
      "disabled": true,
      "readonly": true,
      "description": "Set by the final decision script, for example: Subsidie toegekend or Geen recht op subsidie."
    },
    {
      "label": "Decision type",
      "id": "Field_DecisionType",
      "key": "decisionType",
      "type": "textfield",
      "disabled": true,
      "readonly": true,
      "description": "Expected values: Toegekend or Afgewezen."
    },
    {
      "label": "Right to subsidy / eligible",
      "id": "Field_Eligible",
      "key": "eligible",
      "type": "checkbox",
      "disabled": true,
      "readonly": true,
      "description": "Checked when the DMN/review outcome gives a right to subsidy."
    },
    {
      "label": "Subsidy granted",
      "id": "Field_SubsidyGranted",
      "key": "subsidyGranted",
      "type": "checkbox",
      "disabled": true,
      "readonly": true,
      "description": "Final grant/reject outcome after review."
    },
    {
      "label": "DMN calculated subsidy amount",
      "id": "Field_CalculatedSubsidyAmount",
      "key": "calculatedSubsidyAmount",
      "type": "number",
      "disabled": true,
      "readonly": true,
      "description": "Amount calculated by BehaalbareHoogteSubsidie before any review override.",
      "decimalDigits": 2
    },
    {
      "label": "Final subsidy amount",
      "id": "Field_SubsidyAmount",
      "key": "subsidyAmount",
      "type": "number",
      "disabled": true,
      "readonly": true,
      "description": "Final amount to communicate to the applicant. This is 0 when the application is rejected.",
      "decimalDigits": 2
    },
    {
      "label": "Payment required",
      "id": "Field_PaymentRequired",
      "key": "paymentRequired",
      "type": "checkbox",
      "disabled": true,
      "readonly": true
    },
    {
      "label": "Budget / plafond result",
      "id": "Field_BudgetResult",
      "key": "budgetResult",
      "type": "textfield",
      "disabled": true,
      "readonly": true
    },
    {
      "label": "Eligibility reasoning",
      "id": "Field_RechtMotivering",
      "key": "rechtMotivering",
      "type": "textarea",
      "disabled": true,
      "readonly": true,
      "description": "Reason from the RechtOpSubsidieThuisbatterij DMN decision."
    },
    {
      "label": "Amount reasoning",
      "id": "Field_HoogteMotivering",
      "key": "hoogteMotivering",
      "type": "textarea",
      "disabled": true,
      "readonly": true,
      "description": "Reason from the BehaalbareHoogteSubsidie DMN decision."
    },
    {
      "label": "Review reasoning / override",
      "id": "Field_ReviewMotiveringVastgesteld",
      "key": "reviewMotiveringVastgesteld",
      "type": "textarea",
      "disabled": true,
      "readonly": true,
      "description": "Only filled when the caseworker changed or supplemented the decision during review."
    },
    {
      "label": "Decision message for applicant",
      "id": "Field_FinalMessage",
      "key": "finalMessage",
      "type": "textarea",
      "disabled": true,
      "readonly": true,
      "description": "Message generated by the final decision script."
    },
    {
      "text": "## Notification action",
      "id": "Text_Action",
      "type": "text"
    },
    {
      "label": "Notification method",
      "values": [
        {
          "label": "Email",
          "value": "email"
        },
        {
          "label": "Letter / post",
          "value": "letter"
        },
        {
          "label": "Phone call",
          "value": "phone"
        },
        {
          "label": "Citizen portal",
          "value": "portal"
        }
      ],
      "id": "Field_NotificationMethod",
      "key": "notificationMethod",
      "type": "select",
      "validate": {
        "required": true
      },
      "description": "How should the applicant be informed of this decision?"
    },
    {
      "subtype": "date",
      "id": "Field_NotificationDate",
      "key": "notificationDate",
      "type": "datetime",
      "label": "Notification date",
      "dateLabel": "Notification date",
      "description": "Date on which the decision is or will be sent."
    },
    {
      "label": "Additional notification notes",
      "id": "Field_NotificationNotes",
      "key": "notificationNotes",
      "type": "textarea",
      "description": "Optional internal notes or extra text to include when notifying the applicant."
    },
    {
      "label": "I confirm the applicant will be notified of this subsidy decision",
      "id": "Field_ApplicantNotified",
      "key": "applicantNotified",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Confirm notification",
      "action": "submit",
      "id": "Button_Submit",
      "type": "button"
    }
  ],
  "id": "awb-notify-applicant-thuisbatterij",
  "type": "default",
  "schemaVersion": 19,
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.24.0"
}
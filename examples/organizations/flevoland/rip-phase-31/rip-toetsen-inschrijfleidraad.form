      "validate": {
        "required": true
      }
    },
    {
      "id": "F_Bevindingen",
      "type": "textarea",
      "label": "Findings",
      "key": "bevindingenInschrijfleidraad",
      "validate": {
        "required": true
      }
    },
    {
      "id": "F_Akkoord",
      "type": "select",
      "label": "Inschrijvingsleidraad approved",
      "key": "inschrijfleidraadAkkoord",
      "values": [
        {
          "label": "Yes — approved",
          "value": "ja"
        },
        {
          "label": "No — amendment required",
          "value": "nee"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "id": "F_Getoetst",

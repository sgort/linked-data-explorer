  "components": [
    {
      "id": "Text_Header",
      "type": "text",
      "text": "# Review the tender guide"
    },
    {
      "id": "Text_Intro",
      "type": "text",
      "text": "Kosten- en contractdeskundige and inkoopadviseur werken review the inschrijvingsleidraad and record the findings."
    },
    {
      "id": "F_Bev",
      "type": "textfield",

                    "text": "Directievoerder assessment: {{opleveringBevindingenDv}} Advice: {{opleveringAdvies}}"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Granted: {{opleveringVerzoekToegekend}} — {{opleveringBesluitMotivering}} Decided on {{opleveringBesluitOp}}."
                  }
                ]
              }
            ]

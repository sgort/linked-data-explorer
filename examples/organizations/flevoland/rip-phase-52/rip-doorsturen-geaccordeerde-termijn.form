  "components": [
    {
      "id": "Text_Header",
      "type": "text",
      "text": "# Forward the approved term via VISI"
    },
    {
      "id": "Text_Intro",
      "type": "text",
      "text": "The approved terms fall within the contract, so the term is forwarded through VISI without an AWR overview."
    },
    {
      "id": "F_Visi",
      "type": "textfield",
      "label": "VISI message reference",
      "key": "visiBerichtReferentie",
      "validate": {
        "required": true
      }
    },
    {
      "id": "F_Op",
      "type": "datetime",
      "label": "Forwarded on",
      "key": "termijnDoorgestuurdOp",
      "subtype": "date",
      "dateLabel": "Date",
      "validate": {
        "required": true
      }
    },
    {
      "id": "Button_Submit",
      "type": "button",
      "label": "Submit",
      "action": "submit"
    }
  ]

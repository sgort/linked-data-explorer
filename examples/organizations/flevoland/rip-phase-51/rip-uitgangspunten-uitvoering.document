                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Agreed: {{uitgangspuntenAfspraken}}"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The project contains technical installation(s): {{technischeInstallaties}}. Where it does, the installation part is handed to Beheer & Onderhoud under BO13.1."
                  }
                ]
              }
            ]

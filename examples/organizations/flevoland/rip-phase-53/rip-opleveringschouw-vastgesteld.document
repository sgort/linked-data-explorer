              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Handover agreed: {{opleveringAkkoord}}."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Where it was agreed the area is handed over and R5.4 Oplevering en onderhoudsperiode follows. Where it was not, these restpunten are executed back in R5.2: {{opleveringRestpunten}}"
                  }
                ]

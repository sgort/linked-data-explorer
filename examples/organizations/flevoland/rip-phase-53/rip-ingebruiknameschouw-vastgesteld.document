    "body": {
      "blocks": [
        {
          "id": "bd1",
          "type": "text",
          "label": "Adopted commissioning inspection",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Adopted commissioning inspection"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ingebruiknameschouw {{ingebruiknameschouwReferentie}} for project {{projectNumber}} — {{projectName}} was adopted by {{ingebruiknameVastgesteldDoor}} on {{ingebruiknameVastgesteldOp}}."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Early commissioning agreed: {{ingebruiknameAkkoord}}."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Restpuntenlijst: {{ingebruiknameRestpuntenlijst}}"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Either way the work returns to R5.2. Agreed, {{ingebruiknameDeelAreaal}} goes into early use while the work carries on; not agreed, the ON executes the restpunten first."
                  }
                ]
              }
            ]
          }
        }
      ]
    },

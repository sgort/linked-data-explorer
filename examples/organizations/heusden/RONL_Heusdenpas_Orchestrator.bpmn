<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0" 
                  id="Definitions_RONL_Updated" 
                  targetNamespace="http://bpmn.io/schema/bpmn" 
                  exporter="Camunda Modeler" 
                  exporterVersion="5.38.1" 
                  modeler:executionPlatform="Camunda Platform" 
                  modeler:executionPlatformVersion="7.23.0">
  
  <bpmn:process id="RONL_HeusdenpasOrchestrator_Updated" name="RONL Heusdenpas Orchestrator Updated" isExecutable="true" camunda:historyTimeToLive="30">
    
    <bpmn:startEvent id="StartEvent_RONL" name="Start RONL Evaluation">
      <bpmn:outgoing>Flow_ToSVB</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- SVB Age Information Task -->
    <bpmn:businessRuleTask id="Task_SVB_Leeftijden" 
                           name="SVB: Calculate Age Information" 
                           camunda:decisionRef="SVB_LeeftijdsInformatie">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="aanvragerIsJongerDan18">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("aanvragerIsJongerDan18")}</camunda:outputParameter>
          <camunda:outputParameter name="aanvragerIs181920">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("aanvragerIs181920")}</camunda:outputParameter>
          <camunda:outputParameter name="aanvragerIsTenminste21">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("aanvragerIsTenminste21")}</camunda:outputParameter>
          <camunda:outputParameter name="aanvragerHeeftAOWLeeftijd">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("aanvragerHeeftAOWLeeftijd")}</camunda:outputParameter>
          <camunda:outputParameter name="partnerIsJongerDan18">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("partnerIsJongerDan18")}</camunda:outputParameter>
          <camunda:outputParameter name="partnerIs181920">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("partnerIs181920")}</camunda:outputParameter>
          <camunda:outputParameter name="partnerIsTenminste21">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("partnerIsTenminste21")}</camunda:outputParameter>
          <camunda:outputParameter name="partnerHeeftAOWLeeftijd">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("partnerHeeftAOWLeeftijd")}</camunda:outputParameter>
          <camunda:outputParameter name="leeftijdAanvrager">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("leeftijdAanvrager")}</camunda:outputParameter>
          <camunda:outputParameter name="leeftijdPartner">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("leeftijdPartner")}</camunda:outputParameter>
          <camunda:outputParameter name="AOWDatumAanvrager">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("AOWDatumAanvrager")}</camunda:outputParameter>
          <camunda:outputParameter name="AOWDatumPartner">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("AOWDatumPartner")}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSVB</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSZW</bpmn:outgoing>
    </bpmn:businessRuleTask>
    
    <!-- SZW Bijstandsnorm Task -->
    <bpmn:businessRuleTask id="Task_SZW_Bijstand" 
                           name="SZW: Calculate Bijstandsnorm" 
                           camunda:decisionRef="SZW_BijstandsnormInformatie">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="bijstandsNorm">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("bijstandsNorm")}</camunda:outputParameter>
          <camunda:outputParameter name="bijstandsnormType">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("bijstandsnormType")}</camunda:outputParameter>
          <camunda:outputParameter name="bijstandsnormTermijn">${decisionResult.isEmpty() ? null : decisionResult.getSingleResult().getEntry("bijstandsnormTermijn")}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSZW</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHeusden</bpmn:outgoing>
    </bpmn:businessRuleTask>
    
    <!-- Heusden Decision Task - keeping the same reference since we're not changing the Heusden file in this update -->
    <bpmn:businessRuleTask id="Task_Heusden_Decision" 
                           name="Heusden: Make Final Decision" 
                           camunda:decisionRef="RONL_HeusdenpasEindresultaat">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="aanmerkingHeusdenPas">${decisionResult.getSingleResult().getEntry("aanmerkingHeusdenPas")}</camunda:outputParameter>
          <camunda:outputParameter name="aanmerkingKindPakket">${decisionResult.getSingleResult().getEntry("aanmerkingKindPakket")}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHeusden</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:businessRuleTask>
    
    <bpmn:endEvent id="EndEvent_RONL" name="RONL Evaluation Complete">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_ToSVB" sourceRef="StartEvent_RONL" targetRef="Task_SVB_Leeftijden" />
    <bpmn:sequenceFlow id="Flow_ToSZW" sourceRef="Task_SVB_Leeftijden" targetRef="Task_SZW_Bijstand" />
    <bpmn:sequenceFlow id="Flow_ToHeusden" sourceRef="Task_SZW_Bijstand" targetRef="Task_Heusden_Decision" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Heusden_Decision" targetRef="EndEvent_RONL" />
    
  </bpmn:process>
  
  <!-- BPMN Diagram Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_RONL_Updated">
    <bpmndi:BPMNPlane id="BPMNPlane_RONL_Updated" bpmnElement="RONL_HeusdenpasOrchestrator_Updated">
      
      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_RONL_di" bpmnElement="StartEvent_RONL">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="145" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- SVB Task -->
      <bpmndi:BPMNShape id="Task_SVB_Leeftijden_di" bpmnElement="Task_SVB_Leeftijden">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
    
      <!-- SZW Task -->
      <bpmndi:BPMNShape id="Task_SZW_Bijstand_di" bpmnElement="Task_SZW_Bijstand">
        <dc:Bounds x="540" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
    
      <!-- Heusden Task -->
      <bpmndi:BPMNShape id="Task_Heusden_Decision_di" bpmnElement="Task_Heusden_Decision">
        <dc:Bounds x="840" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- End Event -->
      <bpmndi:BPMNShape id="EndEvent_RONL_di" bpmnElement="EndEvent_RONL">
        <dc:Bounds x="992" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="978" y="145" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="Flow_ToSVB_di" bpmnElement="Flow_ToSVB">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToSZW_di" bpmnElement="Flow_ToSZW">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>
    
      <bpmndi:BPMNEdge id="Flow_ToHeusden_di" bpmnElement="Flow_ToHeusden">
        <di:waypoint x="640" y="120" />
        <di:waypoint x="840" y="120" />
      </bpmndi:BPMNEdge>
    
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="940" y="120" />
        <di:waypoint x="992" y="120" />
      </bpmndi:BPMNEdge>
      
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</bpmn:definitions>
{
  "id": "heusdenpas_beschikking",
  "name": "Heusdenpas Beschikking",
  "description": "Beschikking op een aanvraag voor de Heusdenpas en het Kindpakket van de gemeente Heusden, gevuld met de uitkomst van het BPMN-proces.",
  "processKey": "HeusdenpasAanvraagProcess",
  "serviceId": "HeusdenpasHeusden",
  "schemaVersion": 1,
  "readonly": false,
  "status": "example",
  "language": "nl",
  "organization": "heusden",
  "createdAt": "2026-10-08T16:02:48.233Z",
  "updatedAt": "2026-10-08T16:02:48.233Z",
  "assets": [],
  "bindings": [
    {
      "id": "b1",
      "placeholder": "{{dossierReference}}",
      "variableKey": "dossierReference",
      "source": "process",
      "label": "Dossiernummer"
    },
    {
      "id": "b2",
      "placeholder": "{{applicationDate}}",
      "variableKey": "applicationDate",
      "source": "process",
      "label": "Aanvraagdatum"
    },
    {
      "id": "b3",
      "placeholder": "{{aanvragerNaam}}",
      "variableKey": "aanvragerNaam",
      "source": "process",
      "label": "Naam aanvrager"
    },
    {
      "id": "b4",
      "placeholder": "{{decisionType}}",
      "variableKey": "decisionType",
      "source": "dmn_output",
      "label": "Besluitsoort"
    },
    {
      "id": "b5",
      "placeholder": "{{finalMessage}}",
      "variableKey": "finalMessage",
      "source": "dmn_output",
      "label": "Beslissingstekst"
    },
    {
      "id": "b6",
      "placeholder": "{{heusdenpasMotivering}}",
      "variableKey": "heusdenpasMotivering",
      "source": "dmn_output",
      "label": "Motivering"
    },
    {
      "id": "b7",
      "placeholder": "{{heusdenpasNummer}}",
      "variableKey": "heusdenpasNummer",
      "source": "process",
      "label": "Pasnummer"
    },
    {
      "id": "b8",
      "placeholder": "{{heusdenpasGeldigTot}}",
      "variableKey": "heusdenpasGeldigTot",
      "source": "process",
      "label": "Geldig tot en met"
    },
    {
      "id": "b9",
      "placeholder": "{{awbDeadlineDate}}",
      "variableKey": "awbDeadlineDate",
      "source": "process",
      "label": "Beslistermijn"
    }
  ],
  "zones": {

                "type": "heading",
                "attrs": {
                  "level": 1
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Gemeente Heusden"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Team Werk en Inkomen",
                    "marks": [
                      {
                        "type": "italic"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "lh_separator",
          "type": "separator",
          "label": "Scheidingslijn"
        }
      ]
    },

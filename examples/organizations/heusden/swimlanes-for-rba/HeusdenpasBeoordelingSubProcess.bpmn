<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:ronl="http://ronl.nl/schema/1.0" id="Definitions_Heusdenpas_SubProcess" targetNamespace="https://regels.overheid.nl/services/heusdenpas-heusden/bpmn/subprocess" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collaboration_Heusdenpas_Sub">
    <bpmn:participant id="Participant_Heusdenpas_Sub" name="Heusdenpas - Beoordeling recht op Heusdenpas en Kindpakket" processRef="HeusdenpasBeoordelingSubProcess" />
  </bpmn:collaboration>
  <bpmn:process id="HeusdenpasBeoordelingSubProcess" name="Heusdenpas - Beoordeling recht op Heusdenpas en Kindpakket" isExecutable="true" camunda:historyTimeToLive="365" ronl:language="nl" ronl:organization="heusden">
    <bpmn:documentation>Aangeroepen proces voor de inhoudelijke beoordeling. Voert de beslisketen uit zoals de Chain Composer-template 'Heusdenpas Eligibility Check': SVB_LeeftijdsInformatie (leeftijden en AOW), SZW_BijstandsnormInformatie (bijstandsnorm) en RONL_HeusdenpasEindresultaat (Heusdenpas en Kindpakket). De behandelaar bevestigt of corrigeert de uitkomst. Alle beslissingen zijn gedeeld en zonder tenant uitgerold (decisionRefTenantId=${null}).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_HeusdenpasBeoordelingSubProcess">
      <bpmn:lane id="Lane_Sub_Behandelaar" name="Behandelaar">
        <bpmn:flowNodeRef>Sub_CaseReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sub_Systeem" name="Systeem">
        <bpmn:flowNodeRef>SubStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_PrepareDmnInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_SVB_Leeftijden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_FlattenSVB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_SZW_Bijstandsnorm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_FlattenSZW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Heusden_Eindresultaat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_InterpretResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_ResolveDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_FinalGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_SetGranted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_SetRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SubStart" name="Start beoordeling" ronl:awbPhase="4+5">
      <bpmn:outgoing>Flow_Sub_Start_Prepare</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Sub_PrepareDmnInput" name="Prepareer DMN-invoer" scriptFormat="javascript" ronl:awbPhase="4+5">
      <bpmn:incoming>Flow_Sub_Start_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Prepare_SVB</bpmn:outgoing>
      <bpmn:script>// Prepareer de invoer voor de beslisketen SVB -&gt; SZW -&gt; Heusden.
// Formulierwaarden komen als String/Long binnen; de DMN's verwachten Boolean,
// Double en datums als "YYYY-MM-DD"-strings. Elke invoer wordt hier expliciet
// gezet, ook als hij leeg is: een ontbrekende variabele laat een FEEL-expressie
// falen, een null-waarde niet.

function unwrap(v) {
  if (v === null || v === undefined) { return v; }
  // DMN result entries may be Camunda/Operaton TypedValue objects.
  if (typeof v.getValue === "function") { return v.getValue(); }
  return v;
}

function read(o, k) {
  if (o === null || o === undefined) { return null; }
  // java.util.Map, used when the DMN result mapping is singleResult
  if (typeof o.get === "function") {
    var mv = unwrap(o.get(k));
    if (mv !== null &amp;&amp; mv !== undefined) { return mv; }
  }
  if (o[k] !== undefined) { return unwrap(o[k]); }
  return null;
}

function asBoolean(v) {
  v = unwrap(v);
  if (v === true || v === false) { return v; }
  if (v === null || v === undefined || v === "") { return null; }
  var s = ("" + v).toLowerCase();
  if (s === "true" || s === "ja" || s === "yes" || s === "waar") { return true; }
  if (s === "false" || s === "nee" || s === "no" || s === "onwaar") { return false; }
  return null;
}

function bool(b) { return java.lang.Boolean.valueOf(b === true); }

function asDouble(v) {
  v = unwrap(v);
  if (v === null || v === undefined || v === "") { return null; }
  var n = parseFloat(("" + v).replace(",", "."));
  return isNaN(n) ? null : n;
}

function asDate(v) {
  v = unwrap(v);
  if (v === null || v === undefined || v === "") { return null; }
  return ("" + v).substring(0, 10);
}

var dag = asDate(execution.getVariable("dagVanAanvraag")) || asDate(execution.getVariable("receiptDate")) || new Date().toISOString().substring(0, 10);
execution.setVariable("dagVanAanvraag", dag);

var alleenstaand = asBoolean(execution.getVariable("aanvragerAlleenstaand")) === true;
execution.setVariable("aanvragerAlleenstaand", bool(alleenstaand));
execution.setVariable("geboortedatumAanvrager", asDate(execution.getVariable("geboortedatumAanvrager")));
execution.setVariable("geboortedatumPartner", alleenstaand ? null : asDate(execution.getVariable("geboortedatumPartner")));

var heeftKinderen = asBoolean(execution.getVariable("aanvragerHeeftKinderen")) === true;
execution.setVariable("aanvragerHeeftKinderen", bool(heeftKinderen));
execution.setVariable("aanvragerHeeftKind4Tm17", bool(heeftKinderen &amp;&amp; asBoolean(execution.getVariable("aanvragerHeeftKind4Tm17")) === true));

var inkomen = asDouble(execution.getVariable("maandelijksBrutoInkomenAanvrager"));
execution.setVariable("maandelijksBrutoInkomenAanvrager", inkomen === null ? null : java.lang.Double.valueOf(inkomen));

var flags = [
  "aanvragerInwonerHeusden",
  "aanvragerUitkeringBaanbrekers",
  "aanvragerVoedselbankpasDenBosch",
  "aanvragerKwijtscheldingGemeentelijkeBelastingen",
  "aanvragerSchuldhulptrajectKredietbankNederland",
  "aanvragerDitKalenderjaarAlAangevraagd",
  "aanvragerAanmerkingStudieFinanciering"
];
for (var i = 0; i &lt; flags.length; i++) {
  execution.setVariable(flags[i], bool(asBoolean(execution.getVariable(flags[i])) === true));
}

execution.setVariable("dmnInputPrepared", java.lang.Boolean.TRUE);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Sub_SVB_Leeftijden" name="DMN: SVB leeftijdsinformatie" camunda:resultVariable="svbResult" camunda:decisionRef="SVB_LeeftijdsInformatie" camunda:mapDecisionResult="singleResult" camunda:decisionRefTenantId="${null}" ronl:awbPhase="4+5">
      <bpmn:incoming>Flow_Sub_Prepare_SVB</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_SVB_Flatten</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Sub_FlattenSVB" name="Leeftijden overnemen" scriptFormat="javascript" ronl:awbPhase="4+5">
      <bpmn:incoming>Flow_Sub_SVB_Flatten</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Flatten_SZW</bpmn:outgoing>
      <bpmn:script>// Zet de leeftijdsinformatie van SVB_LeeftijdsInformatie om in losse
// procesvariabelen: SZW en Heusden lezen ze als invoer.

function unwrap(v) {
  if (v === null || v === undefined) { return v; }
  // DMN result entries may be Camunda/Operaton TypedValue objects.
  if (typeof v.getValue === "function") { return v.getValue(); }
  return v;
}

function read(o, k) {
  if (o === null || o === undefined) { return null; }
  // java.util.Map, used when the DMN result mapping is singleResult
  if (typeof o.get === "function") {
    var mv = unwrap(o.get(k));
    if (mv !== null &amp;&amp; mv !== undefined) { return mv; }
  }
  if (o[k] !== undefined) { return unwrap(o[k]); }
  return null;
}

function asBoolean(v) {
  v = unwrap(v);
  if (v === true || v === false) { return v; }
  if (v === null || v === undefined || v === "") { return null; }
  var s = ("" + v).toLowerCase();
  if (s === "true" || s === "ja" || s === "yes" || s === "waar") { return true; }
  if (s === "false" || s === "nee" || s === "no" || s === "onwaar") { return false; }
  return null;
}

function bool(b) { return java.lang.Boolean.valueOf(b === true); }

var svb = execution.getVariable("svbResult");
var keys = [
  "aanvragerIsJongerDan18", "aanvragerIs181920", "aanvragerIsTenminste21", "aanvragerHeeftAOWLeeftijd",
  "partnerIsJongerDan18", "partnerIs181920", "partnerIsTenminste21", "partnerHeeftAOWLeeftijd"
];
for (var i = 0; i &lt; keys.length; i++) {
  execution.setVariable(keys[i], bool(asBoolean(read(svb, keys[i])) === true));
}
execution.setVariable("leeftijdAanvrager", read(svb, "leeftijdAanvrager"));
execution.setVariable("leeftijdPartner", read(svb, "leeftijdPartner"));
execution.setVariable("AOWDatumAanvrager", read(svb, "AOWDatumAanvrager"));
execution.setVariable("AOWDatumPartner", read(svb, "AOWDatumPartner"));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Sub_SZW_Bijstandsnorm" name="DMN: SZW bijstandsnorm" camunda:resultVariable="szwResult" camunda:decisionRef="SZW_BijstandsnormInformatie" camunda:mapDecisionResult="singleResult" camunda:decisionRefTenantId="${null}" ronl:awbPhase="4+5">
      <bpmn:incoming>Flow_Sub_Flatten_SZW</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_SZW_Flatten</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Sub_FlattenSZW" name="Bijstandsnorm overnemen" scriptFormat="javascript" ronl:awbPhase="4+5">
      <bpmn:incoming>Flow_Sub_SZW_Flatten</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Flatten_Heusden</bpmn:outgoing>
      <bpmn:script>// Zet de bijstandsnorm van SZW_BijstandsnormInformatie om in losse
// procesvariabelen. SZW kent alleen normen voor de termijnen in zijn tabel;
// buiten die termijnen is bijstandsNorm null en kan Heusden niet beslissen.

function unwrap(v) {
  if (v === null || v === undefined) { return v; }
  // DMN result entries may be Camunda/Operaton TypedValue objects.
  if (typeof v.getValue === "function") { return v.getValue(); }
  return v;
}

function read(o, k) {
  if (o === null || o === undefined) { return null; }
  // java.util.Map, used when the DMN result mapping is singleResult
  if (typeof o.get === "function") {
    var mv = unwrap(o.get(k));
    if (mv !== null &amp;&amp; mv !== undefined) { return mv; }
  }
  if (o[k] !== undefined) { return unwrap(o[k]); }
  return null;
}

function asBoolean(v) {
  v = unwrap(v);
  if (v === true || v === false) { return v; }
  if (v === null || v === undefined || v === "") { return null; }
  var s = ("" + v).toLowerCase();
  if (s === "true" || s === "ja" || s === "yes" || s === "waar") { return true; }
  if (s === "false" || s === "nee" || s === "no" || s === "onwaar") { return false; }
  return null;
}

function bool(b) { return java.lang.Boolean.valueOf(b === true); }

var szw = execution.getVariable("szwResult");
var norm = read(szw, "bijstandsNorm");
execution.setVariable("bijstandsNorm", norm === null ? null : java.lang.Double.valueOf(Number(norm)));
execution.setVariable("bijstandsnormType", read(szw, "bijstandsnormType"));
execution.setVariable("bijstandsnormTermijn", read(szw, "bijstandsnormTermijn"));
execution.setVariable("bijstandsnormBekend", bool(norm !== null));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Sub_Heusden_Eindresultaat" name="DMN: Heusdenpas en Kindpakket" camunda:resultVariable="heusdenpasResult" camunda:decisionRef="RONL_HeusdenpasEindresultaat" camunda:mapDecisionResult="singleResult" camunda:decisionRefTenantId="${null}" ronl:awbPhase="4">
      <bpmn:incoming>Flow_Sub_Flatten_Heusden</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Heusden_Interpret</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Sub_InterpretResult" name="Interpreteer uitkomst en motivering" scriptFormat="javascript" ronl:awbPhase="4">
      <bpmn:incoming>Flow_Sub_Heusden_Interpret</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Interpret_Review</bpmn:outgoing>
      <bpmn:script>// Interpreteer RONL_HeusdenpasEindresultaat. De DMN geeft alleen ja/nee per
// regeling; de motivering wordt hier uit dezelfde invoer afgeleid, zodat de
// behandelaar en de beschikking kunnen zeggen waarom.
// Een null-uitkomst (bijvoorbeeld zonder bijstandsnorm) is "onbepaald", geen
// afwijzing: de behandelaar beslist dan zelf.

function unwrap(v) {
  if (v === null || v === undefined) { return v; }
  // DMN result entries may be Camunda/Operaton TypedValue objects.
  if (typeof v.getValue === "function") { return v.getValue(); }
  return v;
}

function read(o, k) {
  if (o === null || o === undefined) { return null; }
  // java.util.Map, used when the DMN result mapping is singleResult
  if (typeof o.get === "function") {
    var mv = unwrap(o.get(k));
    if (mv !== null &amp;&amp; mv !== undefined) { return mv; }
  }
  if (o[k] !== undefined) { return unwrap(o[k]); }
  return null;
}

function asBoolean(v) {
  v = unwrap(v);
  if (v === true || v === false) { return v; }
  if (v === null || v === undefined || v === "") { return null; }
  var s = ("" + v).toLowerCase();
  if (s === "true" || s === "ja" || s === "yes" || s === "waar") { return true; }
  if (s === "false" || s === "nee" || s === "no" || s === "onwaar") { return false; }
  return null;
}

function bool(b) { return java.lang.Boolean.valueOf(b === true); }

function euro(n) { return "EUR " + Number(n).toFixed(2).replace(".", ","); }

var res = execution.getVariable("heusdenpasResult");
var hp = asBoolean(read(res, "aanmerkingHeusdenPas"));
var kp = asBoolean(read(res, "aanmerkingKindPakket"));
var bepaald = hp !== null;

function v(k) { return asBoolean(execution.getVariable(k)) === true; }
var inkomen = execution.getVariable("maandelijksBrutoInkomenAanvrager");
var norm = execution.getVariable("bijstandsNorm");

var redenen = [];
if (!v("aanvragerInwonerHeusden")) { redenen.push("U woont niet in de gemeente Heusden."); }
if (v("aanvragerDitKalenderjaarAlAangevraagd")) { redenen.push("U heeft dit kalenderjaar al een Heusdenpas aangevraagd."); }
if (v("aanvragerAanmerkingStudieFinanciering")) { redenen.push("U komt in aanmerking voor studiefinanciering."); }
if (v("aanvragerIsJongerDan18")) { redenen.push("U bent jonger dan 18 jaar."); }

var automatisch = [];
if (v("aanvragerUitkeringBaanbrekers")) { automatisch.push("een uitkering van Baanbrekers"); }
if (v("aanvragerVoedselbankpasDenBosch")) { automatisch.push("een voedselbankpas van Den Bosch"); }
if (v("aanvragerKwijtscheldingGemeentelijkeBelastingen")) { automatisch.push("kwijtschelding van gemeentelijke belastingen"); }
if (v("aanvragerSchuldhulptrajectKredietbankNederland")) { automatisch.push("een schuldhulptraject bij Kredietbank Nederland"); }

var motivering;
if (!bepaald) {
  motivering = norm === null
    ? "De aanvraag kon niet automatisch worden beoordeeld: voor de aanvraagdatum " + execution.getVariable("dagVanAanvraag") + " is geen bijstandsnorm bekend. Beoordeel de aanvraag handmatig."
    : "De aanvraag kon niet automatisch worden beoordeeld. Beoordeel de aanvraag handmatig.";
} else if (redenen.length &gt; 0) {
  motivering = redenen.join(" ");
} else if (hp === true &amp;&amp; automatisch.length &gt; 0) {
  motivering = "U komt automatisch in aanmerking, omdat u " + automatisch.join(", ") + " heeft.";
} else if (hp === true) {
  motivering = "Uw maandelijks bruto inkomen (" + euro(inkomen) + ") is niet hoger dan 110% van de bijstandsnorm (" + euro(1.1 * norm) + ").";
} else {
  motivering = "Uw maandelijks bruto inkomen (" + euro(inkomen) + ") is hoger dan 110% van de bijstandsnorm (" + euro(1.1 * norm) + ").";
}

var kpMotivering = null;
if (bepaald &amp;&amp; kp === true) {
  kpMotivering = "U heeft een inwonend kind van 4 tot en met 17 jaar en uw inkomen is niet hoger dan 120% van de bijstandsnorm.";
} else if (bepaald &amp;&amp; v("aanvragerHeeftKind4Tm17")) {
  kpMotivering = "Voor het Kindpakket is uw inkomen hoger dan 120% van de bijstandsnorm, of woont u niet in Heusden.";
}

execution.setVariable("heusdenpasResultaatBepaald", bool(bepaald));
execution.setVariable("aanmerkingHeusdenPas", bool(hp === true));
execution.setVariable("aanmerkingKindPakket", bool(kp === true));
execution.setVariable("eligible", bool(hp === true));
execution.setVariable("heusdenpasMotivering", motivering);
execution.setVariable("kindpakketMotivering", kpMotivering);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Sub_CaseReview" name="Beoordeling behandelaar: recht op Heusdenpas en Kindpakket" camunda:formRef="heusdenpas-beoordeling" camunda:formRefBinding="deployment" camunda:candidateGroups="caseworker" ronl:awbPhase="5">
      <bpmn:incoming>Flow_Sub_Interpret_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Review_Resolve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Sub_ResolveDecision" name="Definitief besluit vaststellen" scriptFormat="javascript" ronl:awbPhase="5">
      <bpmn:incoming>Flow_Sub_Review_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Resolve_Gateway</bpmn:outgoing>
      <bpmn:script>// Stel het definitieve besluit vast: de DMN-uitkomst, tenzij de behandelaar
// die heeft aangepast. Een onbepaalde uitkomst zonder aanpassing wordt niet
// toegekend: niemand heeft dan vastgesteld dat de aanvrager recht heeft.

function unwrap(v) {
  if (v === null || v === undefined) { return v; }
  // DMN result entries may be Camunda/Operaton TypedValue objects.
  if (typeof v.getValue === "function") { return v.getValue(); }
  return v;
}

function read(o, k) {
  if (o === null || o === undefined) { return null; }
  // java.util.Map, used when the DMN result mapping is singleResult
  if (typeof o.get === "function") {
    var mv = unwrap(o.get(k));
    if (mv !== null &amp;&amp; mv !== undefined) { return mv; }
  }
  if (o[k] !== undefined) { return unwrap(o[k]); }
  return null;
}

function asBoolean(v) {
  v = unwrap(v);
  if (v === true || v === false) { return v; }
  if (v === null || v === undefined || v === "") { return null; }
  var s = ("" + v).toLowerCase();
  if (s === "true" || s === "ja" || s === "yes" || s === "waar") { return true; }
  if (s === "false" || s === "nee" || s === "no" || s === "onwaar") { return false; }
  return null;
}

function bool(b) { return java.lang.Boolean.valueOf(b === true); }

var hp = asBoolean(execution.getVariable("aanmerkingHeusdenPas")) === true;
var kp = asBoolean(execution.getVariable("aanmerkingKindPakket")) === true;
var bepaald = asBoolean(execution.getVariable("heusdenpasResultaatBepaald")) === true;
var action = unwrap(execution.getVariable("reviewAction"));

if (action === "change") {
  hp = asBoolean(execution.getVariable("reviewHeusdenpas")) === true;
  kp = asBoolean(execution.getVariable("reviewKindpakket")) === true;
  var reden = unwrap(execution.getVariable("reviewMotivering"));
  if (reden !== null &amp;&amp; reden !== undefined &amp;&amp; reden !== "") {
    execution.setVariable("heusdenpasMotivering", reden);
    execution.setVariable("reviewMotiveringVastgesteld", reden);
  }
} else if (!bepaald) {
  hp = false;
  kp = false;
  execution.setVariable("heusdenpasMotivering", "Uw recht op de Heusdenpas kon niet worden vastgesteld.");
}

execution.setVariable("heusdenpasToegekend", bool(hp));
execution.setVariable("kindpakketToegekend", bool(kp));
execution.setVariable("besluitPositief", bool(hp || kp));
execution.setVariable("phase5Complete", java.lang.Boolean.TRUE);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Sub_FinalGateway" name="Heusdenpas of Kindpakket toegekend?" ronl:awbPhase="5">
      <bpmn:incoming>Flow_Sub_Resolve_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Final_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sub_Final_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Sub_SetGranted" name="Besluitvariabelen zetten: Toegekend" scriptFormat="javascript" ronl:awbPhase="5">
      <bpmn:incoming>Flow_Sub_Final_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Granted_End</bpmn:outgoing>
      <bpmn:script>function unwrap(v) {
  if (v === null || v === undefined) { return v; }
  // DMN result entries may be Camunda/Operaton TypedValue objects.
  if (typeof v.getValue === "function") { return v.getValue(); }
  return v;
}

function read(o, k) {
  if (o === null || o === undefined) { return null; }
  // java.util.Map, used when the DMN result mapping is singleResult
  if (typeof o.get === "function") {
    var mv = unwrap(o.get(k));
    if (mv !== null &amp;&amp; mv !== undefined) { return mv; }
  }
  if (o[k] !== undefined) { return unwrap(o[k]); }
  return null;
}

function asBoolean(v) {
  v = unwrap(v);
  if (v === true || v === false) { return v; }
  if (v === null || v === undefined || v === "") { return null; }
  var s = ("" + v).toLowerCase();
  if (s === "true" || s === "ja" || s === "yes" || s === "waar") { return true; }
  if (s === "false" || s === "nee" || s === "no" || s === "onwaar") { return false; }
  return null;
}

function bool(b) { return java.lang.Boolean.valueOf(b === true); }

var year = ("" + execution.getVariable("dagVanAanvraag")).substring(0, 4);
var hp = asBoolean(execution.getVariable("heusdenpasToegekend")) === true;
var kp = asBoolean(execution.getVariable("kindpakketToegekend")) === true;
var pasnummer = hp ? "HP-" + year + "-" + Date.now().toString().slice(-6) : null;

execution.setVariable("heusdenpasNummer", pasnummer);
execution.setVariable("heusdenpasGeldigTot", hp ? year + "-12-31" : null);
execution.setVariable("status", hp ? "Heusdenpas toegekend" : "Kindpakket toegekend");
execution.setVariable("decisionType", hp ? "Toegekend" : "Gedeeltelijk toegekend");
execution.setVariable("verstrekkingNodig", java.lang.Boolean.TRUE);
execution.setVariable("chainProcessRequired", java.lang.Boolean.TRUE);

var msg = hp
  ? "Uw aanvraag voor de Heusdenpas is toegekend. Uw pas (nummer " + pasnummer + ") is geldig tot en met 31 december " + year + "."
  : "Uw aanvraag voor de Heusdenpas is afgewezen.";
if (kp) { msg += " U ontvangt daarnaast het Kindpakket."; }
execution.setVariable("finalMessage", msg);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Sub_SetRejected" name="Besluitvariabelen zetten: Afgewezen" scriptFormat="javascript" ronl:awbPhase="5">
      <bpmn:incoming>Flow_Sub_Final_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Rejected_End</bpmn:outgoing>
      <bpmn:script>execution.setVariable("heusdenpasNummer", null);
execution.setVariable("heusdenpasGeldigTot", null);
execution.setVariable("status", "Geen recht op Heusdenpas");
execution.setVariable("decisionType", "Afgewezen");
execution.setVariable("verstrekkingNodig", java.lang.Boolean.FALSE);
execution.setVariable("chainProcessRequired", java.lang.Boolean.TRUE);
execution.setVariable("finalMessage", "Uw aanvraag voor de Heusdenpas is afgewezen. Reden: " + execution.getVariable("heusdenpasMotivering"));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="SubEnd" name="Besluit voorbereid">
      <bpmn:incoming>Flow_Sub_Granted_End</bpmn:incoming>
      <bpmn:incoming>Flow_Sub_Rejected_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Sub_Start_Prepare" sourceRef="SubStart" targetRef="Sub_PrepareDmnInput" />
    <bpmn:sequenceFlow id="Flow_Sub_Prepare_SVB" sourceRef="Sub_PrepareDmnInput" targetRef="Sub_SVB_Leeftijden" />
    <bpmn:sequenceFlow id="Flow_Sub_SVB_Flatten" sourceRef="Sub_SVB_Leeftijden" targetRef="Sub_FlattenSVB" />
    <bpmn:sequenceFlow id="Flow_Sub_Flatten_SZW" sourceRef="Sub_FlattenSVB" targetRef="Sub_SZW_Bijstandsnorm" />
    <bpmn:sequenceFlow id="Flow_Sub_SZW_Flatten" sourceRef="Sub_SZW_Bijstandsnorm" targetRef="Sub_FlattenSZW" />
    <bpmn:sequenceFlow id="Flow_Sub_Flatten_Heusden" sourceRef="Sub_FlattenSZW" targetRef="Sub_Heusden_Eindresultaat" />
    <bpmn:sequenceFlow id="Flow_Sub_Heusden_Interpret" sourceRef="Sub_Heusden_Eindresultaat" targetRef="Sub_InterpretResult" />
    <bpmn:sequenceFlow id="Flow_Sub_Interpret_Review" sourceRef="Sub_InterpretResult" targetRef="Sub_CaseReview" />
    <bpmn:sequenceFlow id="Flow_Sub_Review_Resolve" sourceRef="Sub_CaseReview" targetRef="Sub_ResolveDecision" />
    <bpmn:sequenceFlow id="Flow_Sub_Resolve_Gateway" sourceRef="Sub_ResolveDecision" targetRef="Sub_FinalGateway" />
    <bpmn:sequenceFlow id="Flow_Sub_Final_Yes" name="Ja" sourceRef="Sub_FinalGateway" targetRef="Sub_SetGranted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besluitPositief == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Sub_Final_No" name="Nee" sourceRef="Sub_FinalGateway" targetRef="Sub_SetRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besluitPositief != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Sub_Granted_End" sourceRef="Sub_SetGranted" targetRef="SubEnd" />
    <bpmn:sequenceFlow id="Flow_Sub_Rejected_End" sourceRef="Sub_SetRejected" targetRef="SubEnd" />
  </bpmn:process>

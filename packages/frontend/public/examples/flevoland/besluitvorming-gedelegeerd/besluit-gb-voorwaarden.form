      "id": "Field_Ro_28",
      "type": "textarea",
      "label": "Advies Juridische Zaken / Compliance",
      "key": "advies",
      "readonly": true,
      "disabled": true
    },
    {
      "id": "Field_Text_29",
      "type": "text",
      "text": "Voorwaarden: wet- en regelgeving, provinciaal beleid, begroting en geen politieke gevoeligheid."
    },
    {
      "id": "Field_Cb_30",
      "type": "checkbox",
      "label": "Alle voorwaarden zijn vervuld",

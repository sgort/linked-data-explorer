{
  "name": "RONL",
  "uri": "http://ronl.nl/schema/1.0",
  "prefix": "ronl",
  "xml": { "tagAlias": "lowerCase" },
  "associations": [],
  "types": [
    {
      "name": "DocumentRefMixin",
      "extends": ["bpmn:UserTask"],
      "properties": [
        {
          "name": "documentRef",
          "isAttr": true,
          "type": "String",
          "description": "One or more document template ids, comma-separated. A task can produce several deliverables; see utils/documentRefs.ts for why this is a delimited attribute rather than isMany or child elements."
        },
        {
          "name": "signatureRef",
          "isAttr": true,
          "type": "String",
          "description": "The document template a signature task signs. Bundled at deploy like a documentRef, but names exactly one template."
        }
      ]
    },
    {
      "name": "RopaRefMixin",
      "extends": ["bpmn:Process"],
      "properties": [{ "name": "ropaRef", "isAttr": true, "type": "String" }]
    },
    {
      "name": "DsoActiviteitMixin",
      "extends": ["bpmn:Process"],
      "properties": [{ "name": "dsoActiviteitUrn", "isAttr": true, "type": "String" }]
    },
    {
      "name": "LanguageMixin",
      "extends": ["bpmn:Process"],
      "properties": [{ "name": "language", "isAttr": true, "type": "String" }]
    },
    {
      "name": "OrganizationMixin",
      "extends": ["bpmn:Process"],
      "properties": [{ "name": "organization", "isAttr": true, "type": "String" }]
    }
  ]
}

{
  "name": "@linked-data-explorer/backend",
  "version": "2026.08.9",
  "description": "Backend orchestration service for DMN chain execution",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bash scripts/check-docker.sh && nodemon",
    "docker:check": "bash scripts/check-docker.sh",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "check-format": "prettier --check \"src/**/*.ts\"",
    "format:check": "npm run check-format"
  },
  "keywords": [
    "dmn",
    "bpmn",
    "orchestration",
    "sparql",
    "linked-data",
    "operaton"
  ],
  "author": "RONL - Regels Overheid Nederland",
  "license": "EUPL-1.2",
  "dependencies": {
    "@rdfjs/dataset": "^2.0.3",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^7.2.0",
    "libxmljs2": "^0.37.0",
    "n3": "^1.26.0",
    "pg": "^8.23.0",
    "rdf-validate-shacl": "^0.6.5",
    "sparql-http-client": "^2.4.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/n3": "^1.26.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "ts-node src/index.ts"
  },
  "engines": {
    "node": ">=20.20.2",
    "npm": ">=10.9.9"
  }
}

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Deployment tier label shown on the API root page and /v1/health response.
# Values: dev | acc | prod | test. Falls back to NODE_ENV when unset, so local
# dev needs no change. In Azure, set per App Service:
#   az webapp config appsettings set -g rg-... -n ronl-linkeddata-backend-acc  --settings DEPLOYMENT_ENV=acc
#   az webapp config appsettings set -g rg-... -n ronl-linkeddata-backend-prod --settings DEPLOYMENT_ENV=prod
# DEPLOYMENT_ENV=

# CORS Configuration
# Comma-separated allowlist. An origin that is not listed gets no
# Access-Control-Allow-Origin header and the browser refuses the response; the
# request itself still completes normally. Requests with no Origin header at all
# (curl, server-to-server) always pass — CORS is a browser policy, not an
# authorization boundary.
#
# The value below is the LOCAL DEVELOPMENT list. It is not what the deployed
# tiers hold, and it is not a template for them. Nothing in this repository
# records the deployed values: there is no Bicep, Terraform or ARM, and none of
# the azure-*.yml workflows sets app settings, so each App Service application
# setting is the only copy of its own allowlist. As of 16 September 2026 the
# acceptance list carried https://acc.cpsv-editor.open-regels.nl, an origin that
# appears nowhere in git -- reconstructing the value from this file would have
# silently dropped it.
#
# So: `az webapp config appsettings set` REPLACES the whole value, it does not
# append. Read the current list and pass it back with the additions, in one
# shell so nothing is retyped, and refuse to write if the read came back empty:
#   RG=RONL-Preproduction APP=ronl-linkeddata-backend-acc
#   CUR=$(az webapp config appsettings list -g "$RG" -n "$APP" \
#          --query "[?name=='CORS_ORIGIN'].value" -o tsv)
#   [ -n "$CUR" ] || { echo "empty read -- refusing"; exit 1; }
#   az webapp config appsettings set -g "$RG" -n "$APP" \
#     --settings CORS_ORIGIN="$CUR,https://new.origin.example"
# Losing an origin this way is silent: no error, no failing test, just a partner
# site whose browser calls stop working.
#
# Writing the setting restarts the App Service, and the new value takes effect
# only once the restart completes -- expect the old allowlist to answer for a
# short while afterwards. Verify against the running app, not the CLI read-back:
#   curl -si -H "Origin: https://new.origin.example" \
#     https://acc.backend.linkeddata.open-regels.nl/v1/health | grep -i access-control
#
# The IOU architecture documentation site renders an interactive OpenAPI
# reference pinned to the acceptance server, so its two origins went on the
# ACCEPTANCE backend only (#145). Production keeps its own frontend origins, so
# that a reader of the public documentation cannot reach production Operaton
# from a Send button.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5174,https://linkeddata.open-regels.nl,https://acc.linkeddata.open-regels.nl,https://acc.cpsv.open-regels.nl,https://cpsv.open-regels.nl

# TriplyDB Configuration
TRIPLYDB_ENDPOINT=https://api.open-regels.triply.cc/datasets/stevengort/DMN-discovery/services/DMN-discovery/sparql
TRIPLYDB_TIMEOUT=30000

# Operaton Configuration
# Local dev: ronl-operaton container from the ronl-business-api stack (host port 8081 -> container 8080)
OPERATON_BASE_URL=http://localhost:8081/engine-rest
OPERATON_TIMEOUT=10000
# OPERATON_API_KEY=your-api-key-here (if authentication required)

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Performance Configuration
CHAIN_EXECUTION_TIMEOUT=5000
MAX_CHAIN_DEPTH=10
ENABLE_CACHING=false

# eDOCS
EDOCS_BASE_URL=https://YourServer.com:port/edocsapi/v1.0
EDOCS_LIBRARY=DOCUVITT
EDOCS_USER_ID=
EDOCS_PASSWORD=
EDOCS_STUB_MODE=true

# PostgreSQL (asset storage for BPMN, forms, documents)
# Local dev: reuse the existing ronl-postgres container — create the database and user once:
#   docker exec -it ronl-postgres psql -U postgres -c "CREATE USER lde_user WITH PASSWORD 'lde_password';"
#   docker exec -it ronl-postgres psql -U postgres -c "CREATE DATABASE lde_assets OWNER lde_user;"
#   docker exec -it ronl-postgres psql -U postgres -c "GRANT ALL PRIVILEGES ON DATABASE lde_assets TO lde_user;"
# ACC/PROD: separate Azure Database for PostgreSQL Flexible Server (isolated from RONL Business API)
DATABASE_URL=postgresql://lde_user:lde_password@localhost:5432/lde_assets

# DSO (Digitaal Stelsel Omgevingswet)
# Pre-production environment is the default — switch to service.omgevingswet.overheid.nl for production
DSO_CATALOGUE_BASE_URL=https://service.pre.omgevingswet.overheid.nl/publiek/catalogus/api/opvragen/v3
DSO_RTR_BASE_URL=https://service.pre.omgevingswet.overheid.nl/publiek/toepasbare-regels/api/rtrgegevens/v2
DSO_API_KEY=your-dso-api-key-here
DSO_TIMEOUT=15000

DSO_CATALOGUE_BASE_URL_PROD=https://service.omgevingswet.overheid.nl/publiek/catalogus/api/opvragen/v3
DSO_RTR_BASE_URL_PROD=https://service.omgevingswet.overheid.nl/publiek/toepasbare-regels/api/rtrgegevens/v2
DSO_API_KEY_PROD=your-dso-api-key-here
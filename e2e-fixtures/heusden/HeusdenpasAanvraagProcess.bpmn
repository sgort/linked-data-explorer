<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:ronl="http://ronl.nl/schema/1.0" id="Definitions_Heusdenpas_Main" targetNamespace="https://regels.overheid.nl/services/heusdenpas-heusden/bpmn/main" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collaboration_Heusdenpas_Main">
    <bpmn:participant id="Participant_Heusdenpas_Main" name="Heusdenpas gemeente Heusden - Hoofdproces" processRef="HeusdenpasAanvraagProcess" />
  </bpmn:collaboration>
  <bpmn:process id="HeusdenpasAanvraagProcess" name="Heusdenpas gemeente Heusden - Hoofdproces" isExecutable="true" camunda:historyTimeToLive="365" ronl:language="nl" ronl:organization="heusden">
    <bpmn:documentation>Hoofdproces (Awb-fasering) voor aanvragen van de Heusdenpas en het Kindpakket van de gemeente Heusden. De inhoudelijke beoordeling (fase 4+5) gebeurt in het aangeroepen proces HeusdenpasBeoordelingSubProcess, dat de beslisketen SVB_LeeftijdsInformatie, SZW_BijstandsnormInformatie en RONL_HeusdenpasEindresultaat uitvoert. Ontvankelijkheid (fase 3) is een taak van de behandelaar: de gedeelde AwbCompletenessCheck kent dit product niet.</bpmn:documentation><bpmn:extensionElements><camunda:properties><camunda:property name="boardOwner" value="caseworker" /></camunda:properties></bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_HeusdenpasAanvraagProcess">
      <bpmn:lane id="Lane_Aanvrager" name="Aanvrager">
        <bpmn:flowNodeRef>StartEvent_Aanvraag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Behandelaar" name="Behandelaar">
        <bpmn:flowNodeRef>Task_Phase3_Admissibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestMissingInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StillIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Phase45_Assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Phase6_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Systeem" name="Systeem">
        <bpmn:flowNodeRef>Task_Phase1_Identity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Phase2_Receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefuseToProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Phase7_Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Chain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Phase8_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchivesDMN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Aanvraag</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Aanvraag" name="Aanvraag Heusdenpas ingediend" camunda:formRef="heusdenpas-aanvraag" camunda:formRefBinding="deployment" ronl:awbPhase="1">
      <bpmn:outgoing>Flow_Start_Phase1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Phase1_Identity" name="Fase 1: Rechtsbetrekking vaststellen (identificatie)" scriptFormat="javascript" ronl:awbPhase="1">
      <bpmn:incoming>Flow_Start_Phase1</bpmn:incoming>
      <bpmn:outgoing>Flow_Phase1_Phase2</bpmn:outgoing>
      <bpmn:script>// Fase 1: Rechtsbetrekking vaststellen (identificatie).
// In productie: koppeling met DigiD en de BRP.
var now = new Date();
execution.setVariable("applicationDate", now.toISOString());
execution.setVariable("applicationYear", now.getFullYear());

if (!execution.getVariable("applicantId")) {
  execution.setVariable("applicantId", "AANVRAGER-" + Date.now());
}
// De peildatum voor leeftijden en bijstandsnorm. Het startformulier vult deze;
// ontbreekt hij, dan geldt de dag van indienen.
var dag = execution.getVariable("dagVanAanvraag");
if (dag === null || dag === undefined || dag === "") {
  execution.setVariable("dagVanAanvraag", now.toISOString().substring(0, 10));
}
execution.setVariable("productType", "HeusdenpasHeusden");
execution.setVariable("regeling", "Heusdenpas en Kindpakket gemeente Heusden");
execution.setVariable("competentAuthority", "Gemeente Heusden");
execution.setVariable("authenticationMethod", "DigiD");
execution.setVariable("phase1Complete", true);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Phase2_Receipt" name="Fase 2: Ontvangstbevestiging aanvraag (Awb 4:1)" scriptFormat="javascript" ronl:awbPhase="2">
      <bpmn:incoming>Flow_Phase1_Phase2</bpmn:incoming>
      <bpmn:outgoing>Flow_Phase2_Phase3</bpmn:outgoing>
      <bpmn:script>// Fase 2: Ontvangstbevestiging aanvraag (Awb 4:1).
var receiptDate = new Date();
execution.setVariable("receiptDate", receiptDate.toISOString());

// Beslistermijn Awb 4:13: redelijke termijn, uiterlijk 8 weken.
var deadline = new Date(receiptDate);
deadline.setDate(deadline.getDate() + 56);
execution.setVariable("awbDeadlineDate", deadline.toISOString().substring(0, 10));
execution.setVariable("awbDeadlineDays", 56);
execution.setVariable("awbLegalBasis", "Awb 4:13 lid 1");

var ref = "HP-HEU-" + receiptDate.getFullYear() + "-" + Date.now().toString().slice(-6);
execution.setVariable("dossierReference", ref);
execution.setVariable("phase2Complete", true);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_Phase3_Admissibility" name="Fase 3: Ontvankelijkheid beoordelen (Awb 4:5)" camunda:formRef="heusdenpas-ontvankelijkheid" camunda:formRefBinding="deployment" camunda:candidateGroups="caseworker" ronl:awbPhase="3">
      <bpmn:incoming>Flow_Phase2_Phase3</bpmn:incoming>
      <bpmn:outgoing>Flow_Phase3_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Aanvraag volledig?">
      <bpmn:incoming>Flow_Phase3_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestMissingInfo" name="Aanvullende gegevens opvragen (Awb 4:5)" camunda:formRef="heusdenpas-aanvullende-gegevens" camunda:formRefBinding="deployment" camunda:candidateGroups="caseworker" ronl:awbPhase="3">
      <bpmn:incoming>Flow_Complete_No</bpmn:incoming>
      <bpmn:outgoing>Flow_MissingInfo_Recheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_StillIncomplete" name="Aanvulling ontvangen?">
      <bpmn:incoming>Flow_MissingInfo_Recheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Recheck_Process</bpmn:outgoing>
      <bpmn:outgoing>Flow_Recheck_Refuse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RefuseToProcess" name="Aanvraag buiten behandeling stellen (Awb 4:5 lid 1)" scriptFormat="javascript" ronl:awbPhase="3">
      <bpmn:incoming>Flow_Recheck_Refuse</bpmn:incoming>
      <bpmn:outgoing>Flow_Refuse_Notify</bpmn:outgoing>
      <bpmn:script>execution.setVariable("status", "Niet ontvankelijk");
execution.setVariable("decisionType", "Buiten behandeling gesteld");
execution.setVariable("heusdenpasToegekend", java.lang.Boolean.FALSE);
execution.setVariable("kindpakketToegekend", java.lang.Boolean.FALSE);
execution.setVariable("heusdenpasMotivering", "De aanvraag is niet aangevuld binnen de hersteltermijn.");
execution.setVariable("finalMessage", "Uw aanvraag voor de Heusdenpas is niet in behandeling genomen, omdat de ontbrekende gegevens niet binnen de hersteltermijn zijn ontvangen (Awb 4:5 lid 1).");
execution.setVariable("verstrekkingNodig", java.lang.Boolean.FALSE);
execution.setVariable("chainProcessRequired", java.lang.Boolean.FALSE);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:callActivity id="Task_Phase45_Assessment" name="Fase 4+5: Beoordeling recht op Heusdenpas en Kindpakket" calledElement="HeusdenpasBeoordelingSubProcess" ronl:awbPhase="4+5">
      <bpmn:extensionElements><camunda:in variables="all" /><camunda:out variables="all" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Complete_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Recheck_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Phase45_Phase6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_Phase6_Notify" name="Fase 6: Aanvrager informeren over besluit (Awb 3:41)" camunda:formRef="heusdenpas-besluit-informeren" camunda:formRefBinding="deployment" camunda:candidateGroups="caseworker" ronl:documentRef="heusdenpas_beschikking" ronl:awbPhase="6">
      <bpmn:incoming>Flow_Refuse_Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Phase45_Phase6</bpmn:incoming>
      <bpmn:outgoing>Flow_Phase6_Issue</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Issue" name="Pas of Kindpakket verstrekken?" ronl:awbPhase="7">
      <bpmn:incoming>Flow_Phase6_Issue</bpmn:incoming>
      <bpmn:outgoing>Flow_Issue_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Issue_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Phase7_Issue" name="Fase 7: Heusdenpas (en Kindpakket) verstrekken" scriptFormat="javascript" ronl:awbPhase="7">
      <bpmn:incoming>Flow_Issue_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueTask_Chain</bpmn:outgoing>
      <bpmn:script>// Fase 7: Heusdenpas en/of Kindpakket verstrekken.
// In productie: aanmaak van de pas bij de passenleverancier en verzending.

function unwrap(v) {
  if (v === null || v === undefined) { return v; }
  // DMN result entries may be Camunda/Operaton TypedValue objects.
  if (typeof v.getValue === "function") { return v.getValue(); }
  return v;
}

function read(o, k) {
  if (o === null || o === undefined) { return null; }
  // java.util.Map, used when the DMN result mapping is singleResult
  if (typeof o.get === "function") {
    var mv = unwrap(o.get(k));
    if (mv !== null &amp;&amp; mv !== undefined) { return mv; }
  }
  if (o[k] !== undefined) { return unwrap(o[k]); }
  return null;
}

function asBoolean(v) {
  v = unwrap(v);
  if (v === true || v === false) { return v; }
  if (v === null || v === undefined || v === "") { return null; }
  var s = ("" + v).toLowerCase();
  if (s === "true" || s === "ja" || s === "yes" || s === "waar") { return true; }
  if (s === "false" || s === "nee" || s === "no" || s === "onwaar") { return false; }
  return null;
}

function bool(b) { return java.lang.Boolean.valueOf(b === true); }

execution.setVariable("heusdenpasVerstrekt", bool(asBoolean(execution.getVariable("heusdenpasToegekend")) === true));
execution.setVariable("kindpakketVerstrekt", bool(asBoolean(execution.getVariable("kindpakketToegekend")) === true));
execution.setVariable("verstrekkingDatum", new Date().toISOString());
execution.setVariable("verstrekkingComplete", java.lang.Boolean.TRUE);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Chain" name="Registreren in minimaregister?" ronl:awbPhase="8">
      <bpmn:incoming>Flow_Issue_No</bpmn:incoming>
      <bpmn:incoming>Flow_IssueTask_Chain</bpmn:incoming>
      <bpmn:outgoing>Flow_Chain_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Chain_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Phase8_Register" name="Fase 8: Besluit registreren in ketenproces" scriptFormat="javascript" ronl:awbPhase="8">
      <bpmn:incoming>Flow_Chain_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_Archives</bpmn:outgoing>
      <bpmn:script>// Fase 8: In productie registratie in het minimabeleid-register van de gemeente.
execution.setVariable("chainForwardDate", new Date().toISOString());
execution.setVariable("chainForwardComplete", true);
execution.setVariable("chainForwardTopic", "HeusdenpasHeusden");</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Task_ArchivesDMN" name="Archivering: bewaar- en vernietigingstermijn (Archiefwet)" camunda:resultVariable="archivingResult" camunda:decisionRef="ArchivesActRetention" camunda:mapDecisionResult="singleResult" camunda:decisionRefTenantId="${null}" ronl:awbPhase="archivering">
      <bpmn:incoming>Flow_Chain_No</bpmn:incoming>
      <bpmn:incoming>Flow_Register_Archives</bpmn:incoming>
      <bpmn:outgoing>Flow_ArchivesDMN_Record</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Task_ArchiveRecord" name="Dossier archiveren" scriptFormat="javascript" ronl:awbPhase="archivering">
      <bpmn:incoming>Flow_ArchivesDMN_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Archive_End</bpmn:outgoing>
      <bpmn:script>var result = execution.getVariable("archivingResult");
function read(o, k) {
  if (o == null) { return null; }
  if (typeof o.get === "function") { var v = o.get(k); if (v !== null &amp;&amp; v !== undefined) { return v; } }
  if (o[k] !== undefined) { return o[k]; }
  return null;
}
if (result) {
  execution.setVariable("retentionYears", read(result, "retentionYears"));
  execution.setVariable("retentionClass", read(result, "retentionClass"));
  execution.setVariable("archivingLegalBasis", read(result, "legalBasis"));
  execution.setVariable("destroyable", read(result, "destroyable"));

  var years = parseInt(read(result, "retentionYears") || "7");
  var destroyDate = new Date();
  destroyDate.setFullYear(destroyDate.getFullYear() + years);
  execution.setVariable("destroyAfterDate", destroyDate.toISOString().substring(0, 10));
}
execution.setVariable("archiveDate", new Date().toISOString());
execution.setVariable("archiveComplete", true);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndEvent_Aanvraag" name="Dossier gesloten">
      <bpmn:incoming>Flow_Archive_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Phase1" sourceRef="StartEvent_Aanvraag" targetRef="Task_Phase1_Identity" />
    <bpmn:sequenceFlow id="Flow_Phase1_Phase2" sourceRef="Task_Phase1_Identity" targetRef="Task_Phase2_Receipt" />
    <bpmn:sequenceFlow id="Flow_Phase2_Phase3" sourceRef="Task_Phase2_Receipt" targetRef="Task_Phase3_Admissibility" />
    <bpmn:sequenceFlow id="Flow_Phase3_Gateway" sourceRef="Task_Phase3_Admissibility" targetRef="Gateway_Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_Yes" name="Ja" sourceRef="Gateway_Complete" targetRef="Task_Phase45_Assessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aanvraagVolledig == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Complete_No" name="Nee" sourceRef="Gateway_Complete" targetRef="Task_RequestMissingInfo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aanvraagVolledig != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MissingInfo_Recheck" sourceRef="Task_RequestMissingInfo" targetRef="Gateway_StillIncomplete" />
    <bpmn:sequenceFlow id="Flow_Recheck_Process" name="Ja" sourceRef="Gateway_StillIncomplete" targetRef="Task_Phase45_Assessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supplementReceived == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Recheck_Refuse" name="Nee" sourceRef="Gateway_StillIncomplete" targetRef="Task_RefuseToProcess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supplementReceived != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refuse_Notify" sourceRef="Task_RefuseToProcess" targetRef="Task_Phase6_Notify" />
    <bpmn:sequenceFlow id="Flow_Phase45_Phase6" sourceRef="Task_Phase45_Assessment" targetRef="Task_Phase6_Notify" />
    <bpmn:sequenceFlow id="Flow_Phase6_Issue" sourceRef="Task_Phase6_Notify" targetRef="Gateway_Issue" />
    <bpmn:sequenceFlow id="Flow_Issue_Yes" name="Ja" sourceRef="Gateway_Issue" targetRef="Task_Phase7_Issue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verstrekkingNodig == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Issue_No" name="Nee" sourceRef="Gateway_Issue" targetRef="Gateway_Chain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verstrekkingNodig != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IssueTask_Chain" sourceRef="Task_Phase7_Issue" targetRef="Gateway_Chain" />
    <bpmn:sequenceFlow id="Flow_Chain_Yes" name="Ja" sourceRef="Gateway_Chain" targetRef="Task_Phase8_Register">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${chainProcessRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Chain_No" name="Nee" sourceRef="Gateway_Chain" targetRef="Task_ArchivesDMN">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${chainProcessRequired != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Register_Archives" sourceRef="Task_Phase8_Register" targetRef="Task_ArchivesDMN" />
    <bpmn:sequenceFlow id="Flow_ArchivesDMN_Record" sourceRef="Task_ArchivesDMN" targetRef="Task_ArchiveRecord" />
    <bpmn:sequenceFlow id="Flow_Archive_End" sourceRef="Task_ArchiveRecord" targetRef="EndEvent_Aanvraag" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HeusdenpasAanvraagProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_HeusdenpasAanvraagProcess" bpmnElement="Collaboration_Heusdenpas_Main">

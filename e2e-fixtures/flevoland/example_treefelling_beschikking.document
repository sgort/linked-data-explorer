        },
        {
          "id": "body_message",
          "type": "variable",
          "variableKey": "finalMessage",
          "label": "Beslissingstekst (variabel)"
        },
        {
          "id": "body_motivation_heading",
          "type": "text",
          "label": "Motivering",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Motivering"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "body_motivation",
          "type": "text",
          "label": "Motiveringstekst",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dit besluit is genomen op grond van de Algemene wet bestuursrecht (Awb) en de lokale kapverordening."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bij de beoordeling is rekening gehouden met de diameter van de boom, de ligging in een beschermd gebied en de ecologische waarden."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "closing": {
      "blocks": [
        {
          "id": "cl_replacement",
          "type": "variable",
          "variableKey": "replacementInfo",
          "label": "Herplantinformatie (variabel)"
        },
        {
          "id": "cl_appeal_heading",
          "type": "text",
          "label": "Bezwaarmogelijkheid",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Bezwaar en beroep"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "cl_appeal_text",
          "type": "text",
          "label": "Bezwaartekst",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tegen dit besluit kunt u binnen zes weken na de verzenddatum bezwaar maken."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "U stuurt uw bezwaarschrift naar: Provincie Flevoland, t.a.v. de Commissie Bezwaarschriften, Postbus 1234, 1234 AB Lelystad."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Vermeld in uw bezwaarschrift: uw naam en adres, de datum, het dossiernummer ({{dossierReference}}), en de redenen van uw bezwaar."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In spoedeisende gevallen kunt u een voorlopige voorziening vragen bij de voorzieningenrechter van de rechtbank Midden-Nederland."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "signOff": {
      "blocks": [
        {

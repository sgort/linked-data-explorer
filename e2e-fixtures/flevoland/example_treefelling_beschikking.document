    "body": {
      "blocks": [
        {
          "id": "body_intro",
          "type": "text",
          "label": "Inleiding",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Op uw aanvraag voor een kapvergunning hebben wij het volgende besloten."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "body_decision_heading",
          "type": "text",
          "label": "Besluit",

{
  "e2eFixture": true,
  "schemaVersion": 16,
  "type": "default",
  "id": "awb-notify-applicant",
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.21.0",
  "components": [
    {
      "id": "Text_Header",
      "type": "text",
      "text": "# Fase 6 – Aanvrager informeren over het besluit (Awb 3:6)"
    },
    {
      "id": "Text_AppDetails",
      "type": "text",
      "text": "## Gegevens aanvraag"
    },
    {
      "id": "Field_TreeDiameter",
      "type": "textfield",
      "label": "Stamdiameter (cm)",
      "key": "treeDiameter",
      "readonly": true,
      "disabled": true
    },
    {
      "id": "Field_ProtectedArea",
      "type": "textfield",
      "label": "Beschermd gebied",
      "key": "protectedArea",
      "readonly": true,
      "disabled": true
    },
    {
      "id": "Text_Decision",
      "type": "text",
      "text": "## Besluit"
    },
    {
      "id": "Field_Status",
      "type": "textfield",
      "label": "Status",
      "key": "status",
      "readonly": true,
      "disabled": true
    },
    {
      "id": "Field_PermitDecision",
      "type": "textfield",
      "label": "Vergunningsbesluit",
      "key": "permitDecision",
      "readonly": true,
      "disabled": true
    },
    {
      "id": "Field_FinalMessage",
      "type": "textarea",
      "label": "Beslissingstekst",
      "key": "finalMessage",
      "readonly": true,
      "disabled": true
    },
    {
      "id": "Field_ReplacementInfo",
      "type": "textarea",
      "label": "Herplantinformatie",
      "key": "replacementInfo",
      "readonly": true,
      "disabled": true
    },
    {
      "id": "Text_Action",
      "type": "text",
      "text": "## Bekendmaking"
    },
    {
      "id": "Field_NotificationMethod",
      "type": "select",
      "label": "Wijze van bekendmaking",
      "key": "notificationMethod",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "E-mail",
          "value": "email"
        },
        {
          "label": "Brief (post)",
          "value": "letter"
        },
        {
          "label": "Telefonisch",
          "value": "phone"
        },
        {
          "label": "Burgerportaal",
          "value": "portal"
        }
      ],
      "description": "Hoe wordt de aanvrager over dit besluit geïnformeerd?"
    },
    {
      "id": "Field_NotificationNotes",
      "type": "textarea",
      "label": "Aanvullende opmerkingen",
      "key": "notificationNotes",
      "description": "Optioneel. Deze opmerkingen worden opgenomen in de bekendmaking aan de aanvrager."
    },
    {
      "id": "Field_ApplicantNotified",
      "type": "checkbox",
      "label": "Ik bevestig dat de aanvrager wordt geïnformeerd",
      "key": "applicantNotified",
      "validate": {
        "required": true
      }
    },
    {
      "id": "Button_Submit",
      "type": "button",
      "label": "Bekendmaking bevestigen",
      "action": "submit"
    }
  ]
}

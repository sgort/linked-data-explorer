    },
    {
      "label": "Ontbrekende gegevens",
      "id": "Field_004_kvag",
      "key": "ontbrekendeGegevens",
      "type": "textarea",
      "layout": { "row": "Row_003_kvag", "columns": null },
      "validate": { "required": true }
    },
    {
      "subtype": "date",

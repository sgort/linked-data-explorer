    "body": {
      "blocks": [
        {
          "id": "ot1",
          "type": "text",
          "label": "Design rationale",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": { "level": 2 },
                "content": [{ "type": "text", "text": "Design rationale" }]
              },
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "This design rationale explains the choices made in the concept VO (reference {{conceptVoReferentie}}) for project {{projectNumber}} — {{projectName}}, and how those choices were carried forward into the final VO under reference {{voReferentie}}." }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "The starting points adopted for this design are those set out in the adopted project plan: {{vastgesteldProjectplan}}." }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "The conditioning studies carried out for this project impose the following constraints on the design: {{conditionerendeOnderzoeken}}." }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  { "type": "text", "text": "Design variants were considered before the current design was adopted; the trade-offs weighed between them are recorded alongside the concept VO documentation." }
                ]
              }
            ]
          }
        }
      ]
    },

                    "text": "Geachte aanvrager (ID: {{applicantId}}),"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "body": {
      "blocks": [
        {
          "id": "body_intro",
          "type": "text",
          "label": "Inleiding",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Op uw aanvraag voor subsidie voor een thuisbatterij hebben wij het volgende besloten."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "body_decision_heading",
          "type": "text",
          "label": "Besluit",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Besluit"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "body_decision_outcome",
          "type": "text",
          "label": "BPMN-uitkomst inclusief hoogte",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Uitkomst van de beoordeling: {{decisionType}}."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "{{finalMessage}}"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "De hoogte van de subsidie is vastgesteld op: € {{subsidyAmount}}."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "body_motivation_heading",
          "type": "text",
          "label": "Motivering",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Motivering"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "body_motivation",
          "type": "text",
          "label": "Motiveringstekst",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dit besluit is genomen op grond van de Algemene wet bestuursrecht (Awb) en de subsidieregeling voor thuisbatterijen van Provincie Flevoland."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bij de beoordeling is rekening gehouden met de uitkomst van het BPMN-proces voor recht en hoogte van de subsidie."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "De beslistermijn is vastgesteld op basis van Awb 4:13. De uiterste beslisdatum in het dossier is: {{awbDeadlineDate}}."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "closing": {
      "blocks": [
        {
          "id": "cl_payment",
          "type": "text",
          "label": "Uitbetaling",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Als de subsidie is toegekend, wordt het vastgestelde bedrag uitbetaald volgens de reguliere betalingsprocedure."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Het betalingskenmerk is: {{paymentReference}}."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "cl_appeal_heading",
          "type": "text",
          "label": "Bezwaarmogelijkheid",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Bezwaar en beroep"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "cl_appeal_text",
          "type": "text",
          "label": "Bezwaartekst",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tegen dit besluit kunt u binnen zes weken na de verzenddatum bezwaar maken."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "U stuurt uw bezwaarschrift naar: Provincie Flevoland, t.a.v. de Commissie Bezwaarschriften, Postbus 1234, 1234 AB Lelystad."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Vermeld in uw bezwaarschrift: uw naam en adres, de datum, het dossiernummer ({{dossierReference}}), en de redenen van uw bezwaar."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In spoedeisende gevallen kunt u een voorlopige voorziening vragen bij de voorzieningenrechter van de rechtbank Midden-Nederland."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "signOff": {
      "blocks": [
        {

{
  "name": "linked-data-explorer-monorepo",
  "version": "2026.09.6",
  "private": true,
  "description": "Monorepo for Linked Data Explorer - RONL DMN Orchestration Platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run deps:check && npm run dev --workspace=@linked-data-explorer/frontend",
    "dev:backend": "npm run deps:check && npm run dev --workspace=@linked-data-explorer/backend",
    "dev:full": "npm run deps:check && concurrently \"npm run dev --workspace=@linked-data-explorer/frontend\" \"npm run dev --workspace=@linked-data-explorer/backend\"",
    "deps:check": "bash scripts/check-deps.sh",
    "build": "npm run build --workspace=@linked-data-explorer/frontend",
    "preview": "npm run preview --workspace=@linked-data-explorer/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "check-format": "npm run check-format --workspaces --if-present",
    "check-supply-chain": "node scripts/check-supply-chain.mjs",
    "check-mirror": "bash scripts/check-mirror.sh",
    "authorities:generate": "node scripts/generate-dso-authorities.mjs",
    "dso:dossier": "node scripts/dso-dossier.mjs",
    "prepare": "husky || true",
    "postinstall": "node scripts/write-deps-marker.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "packages/frontend/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write",
      "eslint --config packages/frontend/eslint.config.js --fix"
    ],
    "packages/backend/src/**/*.ts": [
      "prettier --write",
      "eslint --config packages/backend/eslint.config.js --fix"
    ]
  },
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sgort/linked-data-explorer.git"
  },
  "author": "Regels Overheid",
  "license": "EUPL-1.2",
  "scarfSettings": {
    "enabled": false
  }
}
